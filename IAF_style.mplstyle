# Brand style for Matplotlib
# Matches the rcParams configured in the notebook

text.color: 205DA6
axes.labelcolor: 205DA6
xtick.color: 0085CA
ytick.color: 0085CA

font.size: 11
axes.labelsize: 12
axes.titlesize: 14
axes.titleweight: bold

axes.edgecolor: 0085CA
axes.linewidth: 1.0
xtick.direction: out
ytick.direction: out

axes.facecolor: white
figure.facecolor: F0F0F0
axes.grid: True
grid.color: E2E8F0
grid.linestyle: --
grid.linewidth: 0.5

axes.prop_cycle: cycler('color', ['205DA6', 'A2C037', 'F5B835', '009DE0'])
